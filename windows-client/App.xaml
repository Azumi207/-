<Application ShutdownMode="OnLastWindowClose" x:Class="Frameflow.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#2868AE"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="#EDF1F6"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="9,4"/><Setter Property="Margin" Value="2"/><Setter Property="MinHeight" Value="27"/><Setter Property="Background" Value="#F9FBFE"/><Setter Property="BorderBrush" Value="#CCD5E0"/><Setter Property="Foreground" Value="#23354B"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="5,4"/><Setter Property="Margin" Value="3"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#CED7E2"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="5,3"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="27"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="6,4"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="Label"><Setter Property="Padding" Value="5,2"/><Setter Property="Foreground" Value="#536479"/></Style>
 </Application.Resources>
</Application>
